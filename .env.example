# Signal Intel v3 — Environment Variables
# Add these in Vercel Dashboard → Settings → Environment Variables

# Anthropic — console.anthropic.com
# Also handles Brand24 MCP auth via connected connector on same account
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenRouter — exact-model backup for eligible Anthropic billing/rate/5xx failures
OPENROUTER_API_KEY=your_openrouter_key_here

# Brand24 OAuth token — passed to Anthropic MCP server config when available
BRAND24_TOKEN=your_brand24_oauth_token_here

# xAI (Grok) — console.x.ai
XAI_API_KEY=your_xai_key_here

# Perplexity — perplexity.ai/settings/api
# Optional for Competitive Intel Lite; route falls back gracefully without it
PERPLEXITY_API_KEY=your_perplexity_key_here

# Gemini — aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Monitoring REST API — required for complete topical-scan mention pagination
BRAND24_API_KEY=your_brand24_api_key_here
BRAND24_ACCOUNT_ID=your_brand24_account_id_here

# Demo mode — enables hardcoded EastWest social listening pitch snapshot
NEXT_PUBLIC_DEMO_MODE=false

# Optional shared password gate — set only on demo/social-listening deployments
DEMO_ACCESS_PASSWORD=change_me_in_vercel
